+TEST(EnvActionMetadataTest, ImmediateRecvSendReusesEnvsAcrossWorkerThreads) {
+  const auto spec = MakeSpec(4, 3);
+  AsyncEnvPool<ActionProbeEnv> pool(spec);
+  Array ids(Spec<int>({4}));
+  for (int i = 0; i < 4; ++i) {
+    ids[i] = i;
+  }
+  pool.Reset(ids);
+  pool.Recv();
+  constexpr int kIterations = 128;
+  const std::array<std::vector<int>, 3> tails{{{2, 1, 3, 1}, {}, {2, 0, 3}}};
+  for (int iteration = 0; iteration < kIterations; ++iteration) {
+    SCOPED_TRACE(iteration);
+    const std::vector<int> order = iteration % 2 == 0
+                                       ? std::vector<int>{3, 1, 0, 2}
+                                       : std::vector<int>{1, 2, 3, 0};
+    auto batch = MakeBatch(order, tails[iteration % tails.size()],
+                           tails[(iteration + 1) % tails.size()], iteration);
+    std::array<double, 4> expected{};
+    for (int i = 0; i < 4; ++i) {
+      expected[i] = ActionChecksum(ProbeAction(ActionViews(*batch, i)));
+    }
+    // Only this caller uses public APIs. Recv publishes completion while worker
+    // threads may still be returning from EnvStep; immediately replacing the
+    // owning batch exercises the required action cleanup-before-publication.
+    pool.Send(std::move(*batch));
+    batch.reset();
+    ActionProbeEnv::State state(pool.Recv());
+    for (int i = 0; i < 4; ++i) {
+      EXPECT_EQ(static_cast<int>(state["info:env_id"_][i]), order[i]);
+      EXPECT_EQ(static_cast<double>(state["obs:checksum"_][i]), expected[i]);
+    }
+  }
+}
