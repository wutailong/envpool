+  const auto batch = MakeBatch({0, 1});
+  (*batch)[5] = Array(Spec<double>({1, 2, 3}));
+  env.SetAction(batch, 1);
+  EXPECT_DEATH_IF_SUPPORTED(env.ParseAction(), "Check failed");
