+TEST(EnvActionMetadataTest, ExplicitArrayBaseMovesRoundTripThroughTypedAction) {
+  const auto batch = MakeBatch({0, 1}, {2, 3, 4}, {2, 1, 3});
+  auto raw = ActionViews(*batch, 1);
+  std::array<std::uintptr_t, ProbeAction::kSize> shape_addresses{};
+  for (std::size_t i = 0; i < raw.size(); ++i) {
+    shape_addresses[i] =
+        reinterpret_cast<std::uintptr_t>(raw[i].Shape().data());
+  }
+  {
+    ProbeAction action(std::move(raw));
+    ExpectAction(action, *batch, 1);
+    ASSERT_EQ(raw.size(), ProbeAction::kSize);
+    std::size_t i = 0;
+    std::apply(
+        [&](auto&... field) {
+          ((raw[i++] = std::move(static_cast<Array&>(field))), ...);
+        },
+        action.AllValues());
+    std::apply(
+        [](const auto&... field) {
+          auto check = [](const Array& moved) {
+            EXPECT_EQ(moved.Data(), nullptr);
+          };
+          (check(field), ...);
+        },
+        action.AllValues());
+  }
+  for (std::size_t i = 0; i < raw.size(); ++i) {
+    if (!raw[i].Shape().empty()) {
+      EXPECT_EQ(reinterpret_cast<std::uintptr_t>(raw[i].Shape().data()),
+                shape_addresses[i]);
+    }
+  }
+  ProbeAction restored(std::move(raw));
+  ExpectAction(restored, *batch, 1);
+}
