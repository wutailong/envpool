+  // Rebind a non-owning action view without discarding its shape capacity.
+  void RebindSinglePlayerAction(const Array& batch, bool is_player_action,
+                                Array* action) {
+    DCHECK_GT(batch.ndim, static_cast<std::size_t>(0));
+    std::size_t offset = 0;
+    if (is_player_action) {
+      const std::size_t start = env_index_;
+      const std::size_t end = env_index_ + 1;
+      CHECK_GE(batch.shape_[0], end);
+      CHECK_GE(end, start);
+      if (batch.shape_[0] > 0) {
+        offset = start * batch.size / batch.shape_[0];
+      }
+    } else {
+      offset = env_index_;
+      for (std::size_t i = 1; i < batch.ndim; ++i) {
+        offset *= batch.shape_[i];
+      }
+    }
+
+    const std::size_t skip = is_player_action ? 0 : 1;
+    action->shape_.resize(batch.shape_.size() - skip);
+    action->size = 1;
+    for (std::size_t i = 0; i < action->shape_.size(); ++i) {
+      action->shape_[i] =
+          is_player_action && i == 0 ? 1 : batch.shape_[i + skip];
+      action->size *= action->shape_[i];
+    }
+    action->ndim = action->shape_.size();
+    action->element_size = batch.element_size;
+    char* data = batch.ptr_.get();
+    const std::size_t byte_offset = offset * batch.element_size;
+    if (byte_offset != 0) {
+      data += byte_offset;
+    }
+    action->ptr_ = std::shared_ptr<char>(std::shared_ptr<char>(), data);
+  }
+
