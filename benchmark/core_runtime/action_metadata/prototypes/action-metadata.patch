+TEST_F(EnvActionTest, ResetStepResetStepAndThrowingStepCanParseAgain) {
+  auto state = Run(true);
+  EXPECT_EQ(static_cast<int>(state["elapsed_step"_][0]), 0);
+  env_.SetAction(MakeBatch({1}), 0);
+  state = Run();
+  EXPECT_EQ(static_cast<int>(state["elapsed_step"_][0]), 1);
+  state = Run(true);
+  EXPECT_EQ(static_cast<int>(state["elapsed_step"_][0]), 0);
+  const auto next = MakeBatch({2, 1}, {}, {2, 1, 3, 1, 2}, 4);
+  env_.SetAction(next, 1);
+  env_.inspect = [](const ProbeAction&) { throw std::runtime_error("step"); };
+  EXPECT_THROW(env_.EnvStep(&queue_, 0, false, false), std::runtime_error);
+  env_.inspect = [&](const ProbeAction& action) {
+    ExpectAction(action, *next, 1);
+  };
+  env_.ParseAction();
+  state = Run();
+  EXPECT_EQ(env_.reset_count, 2);
+  EXPECT_EQ(env_.step_count, 3);
+  EXPECT_EQ(static_cast<int>(state["elapsed_step"_][0]), 2);
+  EXPECT_EQ(static_cast<double>(state["obs:checksum"_][0]),
+            ActionChecksum(ProbeAction(ActionViews(*next, 1))));
+}
