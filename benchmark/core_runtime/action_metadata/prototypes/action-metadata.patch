+struct ActionProbeFns {
+  static auto DefaultConfig() { return MakeDict(); }
+
+  template <typename Config>
+  static auto StateSpec(const Config&) {
+    return MakeDict("obs:checksum"_.Bind(Spec<double>({})));
+  }
+
+  template <typename Config>
+  static auto ActionSpec(const Config&) {
+    return MakeDict("scalar"_.Bind(Spec<std::int64_t>({})),
+                    "players.scalar"_.Bind(Spec<float>({-1})),
+                    "tensor"_.Bind(Spec<std::uint8_t>({2, 3})),
+                    "players.tensor"_.Bind(Spec<double>({-1, 2, 3, 2})));
+  }
+};
+
+using ActionProbeSpec = EnvSpec<ActionProbeFns>;
+using ProbeAction = Env<ActionProbeSpec>::Action;
+constexpr std::array kPlayerFields = {false, true, false, true, false, true};
+static_assert(kPlayerFields.size() == ProbeAction::kSize);
+
+template <typename T>
+double FieldChecksum(const TArray<T>& field) {
+  double sum = static_cast<double>(field.ndim + field.size);
+  for (std::size_t i = 0; i < field.ndim; ++i) {
+    sum += static_cast<double>((i + 1) * field.Shape(i));
+  }
+  const auto* data = static_cast<const T*>(field.Data());
+  for (std::size_t i = 0; i < field.size; ++i) {
+    sum += static_cast<double>(data[i]);
+  }
+  return sum;
+}
+
+double ActionChecksum(const ProbeAction& action) {
+  double sum = 0;
+  std::apply(
+      [&](const auto&... field) { ((sum += FieldChecksum(field)), ...); },
+      action.AllValues());
+  return sum;
+}
+
+class ActionProbeEnv : public Env<ActionProbeSpec> {
+ public:
+  using Env<ActionProbeSpec>::Env;
+  std::function<void(const Action&)> inspect;
+  int reset_count{0};
+  int step_count{0};
+
+  void Reset() override {
+    ++reset_count;
+    WriteState(-1.0);
+  }
+
+  void Step(const Action& action) override {
+    ++step_count;
+    if (inspect) {
+      // Exceptions in these tests happen before Allocate: a failed Step must
+      // not leave an unpublished slot in the state queue.
+      inspect(action);
+    }
+    WriteState(ActionChecksum(action));
+  }
+
+  bool IsDone() override { return false; }
+
+ private:
+  void WriteState(double checksum) {
+    auto state = Allocate();
+    state["obs:checksum"_] = checksum;
+    state["reward"_] = 0.0F;
+  }
+};
+
+ActionProbeSpec MakeSpec(int num_envs = 4, int num_threads = 2) {
+  auto config = ActionProbeSpec::kDefaultConfig;
+  config["num_envs"_] = num_envs;
+  config["batch_size"_] = num_envs;
+  config["num_threads"_] = num_threads;
+  return ActionProbeSpec(config);
+}
+
+std::vector<int> BatchShape(int batch, const std::vector<int>& tail) {
+  std::vector<int> shape{batch};
+  shape.insert(shape.end(), tail.begin(), tail.end());
+  return shape;
+}
+
+std::shared_ptr<std::vector<Array>> MakeBatch(
+    const std::vector<int>& env_ids, const std::vector<int>& env_tail = {2, 3},
+    const std::vector<int>& player_tail = {2, 3, 2}, int seed = 1) {
+  const int batch_size = static_cast<int>(env_ids.size());
+  auto batch = std::make_shared<std::vector<Array>>();
+  batch->emplace_back(Spec<int>({batch_size}));
+  batch->emplace_back(Spec<int>({batch_size}));
+  batch->emplace_back(Spec<std::int64_t>({batch_size}));
+  batch->emplace_back(Spec<float>({batch_size}));
+  batch->emplace_back(Spec<std::uint8_t>(BatchShape(batch_size, env_tail)));
+  batch->emplace_back(Spec<double>(BatchShape(batch_size, player_tail)));
+  ProbeAction action(*batch);
+  for (int i = 0; i < batch_size; ++i) {
+    action["env_id"_][i] = env_ids[i];
+    action["players.env_id"_][i] = env_ids[i];
+    action["scalar"_][i] = seed * 1000 + i;
+    action["players.scalar"_][i] = seed * 100 + i + 0.5F;
+  }
+  auto* bytes = static_cast<std::uint8_t*>(action["tensor"_].Data());
+  for (std::size_t i = 0; i < action["tensor"_].size; ++i) {
+    bytes[i] = static_cast<std::uint8_t>((seed + i) % 251);
+  }
+  auto* doubles = static_cast<double*>(action["players.tensor"_].Data());
+  for (std::size_t i = 0; i < action["players.tensor"_].size; ++i) {
+    doubles[i] = seed * 1000 + static_cast<double>(i) + 0.25;
+  }
+  return batch;
+}
+
+// Use the established public slicing operations as the metadata/data oracle.
+// Variable trailing ranks intentionally exercise the actual batch metadata;
+// Env's parser classifies player fields from the spec, not their batch rank.
+std::vector<Array> ActionViews(const std::vector<Array>& batch, int index) {
+  std::vector<Array> views;
+  for (std::size_t i = 0; i < batch.size(); ++i) {
+    views.push_back(kPlayerFields[i] ? batch[i].Slice(index, index + 1)
+                                     : batch[i][index]);
+  }
+  return views;
+}
+
+void ExpectAction(const ProbeAction& action, const std::vector<Array>& batch,
+                  int index) {
+  const auto expected = ActionViews(batch, index);
+  std::size_t i = 0;
+  std::apply(
+      [&](const auto&... field) {
+        auto check = [&](const Array& actual) {
+          SCOPED_TRACE(i);
+          EXPECT_EQ(actual.Shape(), expected[i].Shape());
+          EXPECT_EQ(actual.ndim, expected[i].ndim);
+          EXPECT_EQ(actual.size, expected[i].size);
+          EXPECT_EQ(actual.element_size, expected[i].element_size);
+          EXPECT_EQ(actual.Data(), expected[i].Data());
+          EXPECT_EQ(actual.SharedPtr().use_count(), 0);
+          ++i;
+        };
+        (check(field), ...);
+      },
+      action.AllValues());
+}
+
+class EnvActionTest : public testing::Test {
+ protected:
+  ActionProbeSpec spec_{MakeSpec()};
+  StateBufferQueue queue_{1, 4, 1, spec_.state_spec.AllValues<ShapeSpec>()};
+  ActionProbeEnv env_{spec_, 1};
+
+  ActionProbeEnv::State Run(bool reset = false) {
+    env_.EnvStep(&queue_, 0, reset, reset);
+    return ActionProbeEnv::State(queue_.Wait());
+  }
+};
+
+TEST_F(EnvActionTest, MixedDtypesUseReorderedBatchIndexAndReplacementStorage) {
+  auto batch = MakeBatch({3, 0, 1, 2});
+  env_.inspect = [&](const ProbeAction& action) {
+    ExpectAction(action, *batch, 2);
+    EXPECT_TRUE(action["scalar"_].Shape().empty());
+    EXPECT_EQ(action["scalar"_].size, 1U);
+    EXPECT_EQ(action["players.scalar"_].Shape(), std::vector<std::size_t>({1}));
+    EXPECT_EQ(static_cast<std::int64_t>(action["scalar"_]), 1002);
+    EXPECT_EQ(static_cast<float>(action["players.scalar"_][0]), 102.5F);
+  };
+  env_.SetAction(batch, 2);
+  Run();
+
+  batch = MakeBatch({1, 2}, {2, 3}, {2, 3, 2}, 7);
+  env_.inspect = [&](const ProbeAction& action) {
+    ExpectAction(action, *batch, 0);
+    EXPECT_EQ(static_cast<std::int64_t>(action["scalar"_]), 7000);
+    EXPECT_EQ(static_cast<float>(action["players.scalar"_][0]), 700.5F);
+  };
+  env_.SetAction(batch, 0);
+  Run();
+}
+
+TEST_F(EnvActionTest, ReusesShapeStorageAfterRankGrowthShrinkAndEmptyTails) {
+  const std::vector<std::vector<int>> tails{{2},    {2, 1, 3, 1, 2, 1, 1, 1},
+                                            {},     {2, 0, 3},
+                                            {3, 2}, {2, 1, 3, 1, 2, 1, 1, 1}};
+  std::array<std::uintptr_t, 2> shape_addresses{};
+  std::array<std::size_t, 2> capacities{};
+  for (std::size_t iteration = 0; iteration < tails.size(); ++iteration) {
+    SCOPED_TRACE(iteration);
+    const auto batch = MakeBatch({0, 1, 2}, tails[iteration], tails[iteration]);
+    env_.inspect = [&](const ProbeAction& action) {
+      ExpectAction(action, *batch, 1);
+      const std::array<const Array*, 2> fields{&action["tensor"_],
+                                               &action["players.tensor"_]};
+      for (std::size_t i = 0; i < fields.size(); ++i) {
+        const auto& shape = fields[i]->Shape();
+        if (iteration == 1) {
+          shape_addresses[i] = reinterpret_cast<std::uintptr_t>(shape.data());
+          capacities[i] = shape.capacity();
+        } else if (iteration > 1) {
+          EXPECT_EQ(shape.capacity(), capacities[i]);
+          if (!shape.empty()) {
+            EXPECT_EQ(reinterpret_cast<std::uintptr_t>(shape.data()),
+                      shape_addresses[i]);
+          }
+        }
+      }
+    };
+    env_.SetAction(batch, 1);
+    // Re-parsing before Step must also preserve a valid, independently sized
+    // cache, rather than depending on the preceding Action's moved-from state.
+    env_.ParseAction();
+    Run();
+  }
+}
+
+TEST_F(EnvActionTest, CopiedActionAndFieldMetadataRemainIndependent) {
+  const auto original = MakeBatch({2, 1, 0}, {2, 3, 4}, {2, 1, 3}, 5);
+  std::unique_ptr<ProbeAction> saved_action;
+  std::unique_ptr<TArray<double>> saved_field;
+  env_.inspect = [&](const ProbeAction& action) {
+    saved_action = std::make_unique<ProbeAction>(action);
+    saved_field = std::make_unique<TArray<double>>(action["players.tensor"_]);
+    EXPECT_NE(saved_field->Shape().data(),
+              action["players.tensor"_].Shape().data());
+    EXPECT_NE((*saved_action)["tensor"_].Shape().data(),
+              action["tensor"_].Shape().data());
+  };
+  env_.SetAction(original, 1);
+  Run();
+  env_.inspect = {};
+  for (const auto& tail : std::vector<std::vector<int>>{{}, {0, 2}, {3, 2}}) {
+    env_.SetAction(MakeBatch({1, 0}, tail, tail, 9), 0);
+    Run();
+    ExpectAction(*saved_action, *original, 1);
+    EXPECT_EQ(saved_field->Shape(), std::vector<std::size_t>({1, 2, 1, 3}));
+    EXPECT_EQ(saved_field->size, 6U);
+    EXPECT_EQ(static_cast<double>((*saved_field)(0, 1, 0, 2)), 5011.25);
+  }
+  saved_field->TruncateInPlace(0);
+  EXPECT_EQ(saved_field->size, 0U);
+  EXPECT_EQ((*saved_action)["players.tensor"_].Shape(0), 1U);
+  EXPECT_EQ((*original)[5].Shape(0), 3U);
+}
