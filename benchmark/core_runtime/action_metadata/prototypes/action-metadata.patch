+TEST_F(EnvActionTest, BorrowedCopiesDoNotExtendOwningBatchLifetime) {
+  int delete_count = 0;
+  auto batch = MakeBatch({0, 1});
+  const ShapeSpec tensor_spec(sizeof(std::uint8_t), {2, 2, 3});
+  auto* storage = new char[12]{};
+  (*batch)[4] = Array(tensor_spec, storage, [&](char* ptr) {
+    ++delete_count;
+    delete[] ptr;
+  });
+  const std::weak_ptr<char> owner = (*batch)[4].SharedPtr();
+  std::unique_ptr<ProbeAction> saved;
+  std::shared_ptr<char> borrowed;
+  env_.inspect = [&](const ProbeAction& action) {
+    saved = std::make_unique<ProbeAction>(action);
+    borrowed = action["tensor"_].SharedPtr();
+    EXPECT_EQ(borrowed.get(), storage + 6);
+    EXPECT_EQ(borrowed.use_count(), 0);
+  };
+  env_.SetAction(batch, 1);
+  Run();
+  batch.reset();
+  EXPECT_FALSE(owner.expired());
+  EXPECT_EQ(delete_count, 0);
+  Run(true);
+  EXPECT_FALSE(owner.expired());
+  EXPECT_EQ(delete_count, 0);
+
+  // SetAction replaces the Env's owning batch. Neither cached views nor copies
+  // retained by Step may change the backing storage's existing lifetime.
+  env_.inspect = {};
+  env_.SetAction(MakeBatch({1}), 0);
+  EXPECT_TRUE(owner.expired());
+  EXPECT_EQ(delete_count, 1);
+  saved.reset();
+  borrowed.reset();
+  Run();
+  EXPECT_EQ(delete_count, 1);
+}
