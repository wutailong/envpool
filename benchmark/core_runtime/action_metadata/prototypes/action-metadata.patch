+TEST(EnvActionDeathTest, SinglePlayerRejectsZeroLeadingPlayerDimension) {
+  const auto spec = MakeSpec();
+  ActionProbeEnv env(spec, 1);
+  const auto batch = MakeBatch({1});
+  (*batch)[1] = Array(Spec<int>({0}));
+  env.SetAction(batch, 0);
+  EXPECT_DEATH_IF_SUPPORTED(env.ParseAction(), "Check failed");
+}
