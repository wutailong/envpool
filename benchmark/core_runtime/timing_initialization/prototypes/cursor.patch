diff --git a/envpool/core/action_buffer_queue.h b/envpool/core/action_buffer_queue.h
index b457b76..c8dc15d 100644
--- a/envpool/core/action_buffer_queue.h
+++ b/envpool/core/action_buffer_queue.h
@@ -63 +63,4 @@ class ActionBufferQueue {
-    uint64_t pos = alloc_ptr_.fetch_add(action.size());
+    // Writers are serialized by the enqueue semaphore. Keep the cursor atomic
+    // for approximate readers without a redundant read-modify-write.
+    uint64_t pos = alloc_ptr_.load(std::memory_order_relaxed);
