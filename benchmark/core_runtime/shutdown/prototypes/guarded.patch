diff --git a/envpool/core/action_buffer_queue.h b/envpool/core/action_buffer_queue.h
index 4aacfde..abc2f0d 100644
--- a/envpool/core/action_buffer_queue.h
+++ b/envpool/core/action_buffer_queue.h
@@ -70,0 +71,10 @@ class ActionBufferQueue {
+  // Terminal shutdown only: the caller must publish stop, quiesce producers,
+  // and retain the worker's post-Dequeue stop check. Serialize sentinel writes
+  // with payload copies even when the worker count exceeds ring capacity.
+  void EnqueueForShutdown(const std::vector<ActionSlice>& action) {
+    while (!sem_dequeue_.wait()) {
+    }
+    EnqueueBulk(action);
+    sem_dequeue_.signal(1);
+  }
+
diff --git a/envpool/core/action_buffer_queue_test.cc b/envpool/core/action_buffer_queue_test.cc
index c013938..ca33633 100644
--- a/envpool/core/action_buffer_queue_test.cc
+++ b/envpool/core/action_buffer_queue_test.cc
@@ -18,0 +19,3 @@
+#include <atomic>
+#include <chrono>
+#include <future>
@@ -20,0 +24 @@
+#include <thread>
@@ -32,0 +37,86 @@ using ActionSlice = typename ActionBufferQueue::ActionSlice;
+namespace {
+
+class GatedActionBufferQueue : public ActionBufferQueue {
+ public:
+  using ActionBufferQueue::ActionBufferQueue;
+
+  ActionSlice DequeueWithCopyGate(std::promise<void>* ticket_reserved,
+                                  std::future<void>* copy_allowed) {
+    // Duplicate the small consumer protocol only to pause inside its existing
+    // critical section. This tests EnqueueForShutdown's serialization contract,
+    // rather than adding a production Dequeue hook or changing worker behavior.
+    while (!sem_.wait()) {
+    }
+    while (!sem_dequeue_.wait()) {
+    }
+    auto ptr = done_ptr_.fetch_add(1);
+    ticket_reserved->set_value();
+    copy_allowed->wait();
+    auto ret = queue_[ptr % queue_size_];
+    sem_dequeue_.signal(1);
+    return ret;
+  }
+};
+
+}  // namespace
+
+TEST(ActionBufferQueueTest, ShutdownWaitsForInFlightPayloadCopy) {
+  GatedActionBufferQueue queue(1);  // Two ring slots, two workers.
+  const ActionSlice original{.env_id = 0, .order = 17, .force_reset = true};
+  const ActionSlice sentinel{.env_id = -1, .order = -1, .force_reset = false};
+  queue.EnqueueBulk({original});
+
+  std::atomic<bool> stop{false};
+  std::promise<void> ticket_reserved;
+  auto reserved = ticket_reserved.get_future();
+  std::promise<void> allow_copy;
+  auto copy_allowed = allow_copy.get_future();
+  std::promise<void> shutdown_started;
+  auto started = shutdown_started.get_future();
+  std::promise<void> shutdown_finished;
+  auto finished = shutdown_finished.get_future();
+  ActionSlice copied{};
+  ActionSlice idle_copy{};
+  bool copying_worker_stopped = false;
+  bool idle_worker_stopped = false;
+
+  std::thread copying_worker([&] {
+    copied = queue.DequeueWithCopyGate(&ticket_reserved, &copy_allowed);
+    // Match the production worker's stop observation after Dequeue returns.
+    copying_worker_stopped = stop.load();
+  });
+  reserved.wait();  // Consume the real permit and reserve slot zero first.
+  std::thread idle_worker([&] {
+    idle_copy = queue.Dequeue();
+    idle_worker_stopped = stop.load();
+  });
+  std::thread shutdown([&] {
+    stop.store(true);
+    shutdown_started.set_value();
+    // Starting at slot one, two sentinels wrap onto the held original slot.
+    queue.EnqueueForShutdown({sentinel, sentinel});
+    shutdown_finished.set_value();
+  });
+  started.wait();
+  EXPECT_EQ(finished.wait_for(std::chrono::milliseconds(100)),
+            std::future_status::timeout);
+
+  // Always release the held copy, even after a failed expectation. All queue,
+  // payload, stop flag and gate owners remain alive until every thread joins.
+  // The outer test runner's subprocess timeout bounds a broken shutdown join.
+  allow_copy.set_value();
+  copying_worker.join();
+  shutdown.join();
+  idle_worker.join();
+
+  EXPECT_EQ(copied.env_id, original.env_id);
+  EXPECT_EQ(copied.order, original.order);
+  EXPECT_EQ(copied.force_reset, original.force_reset);
+  EXPECT_TRUE(copying_worker_stopped);
+  EXPECT_EQ(idle_copy.env_id, sentinel.env_id);
+  EXPECT_EQ(idle_copy.order, sentinel.order);
+  EXPECT_EQ(idle_copy.force_reset, sentinel.force_reset);
+  EXPECT_TRUE(idle_worker_stopped);
+  EXPECT_EQ(queue.SizeApprox(), 1);
+}
+
