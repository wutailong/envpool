+using Queue = ActionBufferQueue;
+using ActionSlice = Queue::ActionSlice;
+
+ActionSlice MakeAction(int order) noexcept {
+  return ActionSlice{.env_id = (order * 7 + 3) % 13,
+                     .order = order,
+                     .force_reset = order % 3 == 0};
+}
+
+struct NothrowGetter {
+  ActionSlice operator()(std::size_t) noexcept;
+};
+
+struct ThrowingGetter {
+  ActionSlice operator()(std::size_t);
+};
+
+struct WrongResultGetter {
+  int operator()(std::size_t) noexcept;
+};
+
+struct RvalueNothrowGetter {
+  int* rvalue_calls;
+  int* lvalue_calls;
+
+  ActionSlice operator()(std::size_t&& i) noexcept {
+    ++*rvalue_calls;
+    return MakeAction(static_cast<int>(i));
+  }
+
+  ActionSlice operator()(std::size_t&) {
+    ++*lvalue_calls;
+    return MakeAction(0);
+  }
+};
+
+struct LvalueNothrowGetter {
+  ActionSlice operator()(std::size_t&&);
+  ActionSlice operator()(std::size_t&) noexcept;
+};
+
+template <typename Getter>
+using BulkResult = decltype(std::declval<Queue&>().EnqueueBulkGenerated(
+    std::declval<std::size_t>(), std::declval<Getter>()));
+
+template <typename Getter, typename = void>
+struct CanGenerateBulk : std::false_type {};
+
+template <typename G>
+struct CanGenerateBulk<G, std::void_t<BulkResult<G>>> : std::true_type {};
+
+static_assert(CanGenerateBulk<NothrowGetter>::value);
+static_assert(CanGenerateBulk<NothrowGetter&>::value);
+static_assert(!CanGenerateBulk<ThrowingGetter>::value);
+static_assert(!CanGenerateBulk<ThrowingGetter&>::value);
+static_assert(!CanGenerateBulk<WrongResultGetter>::value);
+static_assert(CanGenerateBulk<RvalueNothrowGetter>::value);
+static_assert(CanGenerateBulk<RvalueNothrowGetter&>::value);
+static_assert(!CanGenerateBulk<LvalueNothrowGetter>::value);
+static_assert(!CanGenerateBulk<LvalueNothrowGetter&>::value);
+// Keeping the legacy API unoverloaded preserves existing member pointers.
+using LegacyEnqueue = void (Queue::*)(const std::vector<ActionSlice>&);
+static_assert(std::is_same_v<decltype(&Queue::EnqueueBulk), LegacyEnqueue>);
+
+class InspectableQueue : public ActionBufferQueue {
+ public:
+  explicit InspectableQueue(std::size_t num_envs, std::uint64_t position = 0)
+      : ActionBufferQueue(num_envs) {
+    alloc_ptr_.store(position);
+    done_ptr_.store(position);
+  }
+
+  std::uint64_t Allocated() const { return alloc_ptr_.load(); }
+  std::uint64_t Dequeued() const { return done_ptr_.load(); }
+  ActionSlice Slot(std::size_t index) const { return queue_[index]; }
+};
+
+// The queue has no backpressure. Reserve a whole batch before enqueueing and
+// return credits only after Dequeue has copied its payload out of the ring.
+class QueueCredits {
+ public:
+  explicit QueueCredits(std::size_t capacity) : available_(capacity) {}
+
+  void Acquire(std::size_t count) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    ready_.wait(lock, [&] { return available_ >= count; });
+    available_ -= count;
+  }
+
+  void Release() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++available_;
+    }
+    ready_.notify_all();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::condition_variable ready_;
+  std::size_t available_;
+};
+
+void ExpectSame(const ActionSlice& actual, const ActionSlice& expected) {
+  EXPECT_EQ(actual.env_id, expected.env_id);
+  EXPECT_EQ(actual.order, expected.order);
+  EXPECT_EQ(actual.force_reset, expected.force_reset);
+}
+
+void Enqueue(InspectableQueue* queue, int first, int count, bool generated) {
+  if (generated) {
+    queue->EnqueueBulkGenerated(count, [first](std::size_t i) noexcept {
+      return MakeAction(first + static_cast<int>(i));
+    });
+  } else {
+    std::vector<ActionSlice> actions;
+    for (int i = 0; i < count; ++i) {
+      actions.push_back(MakeAction(first + i));
+    }
+    queue->EnqueueBulk(actions);
+  }
+}
+
+void CompareBatches(std::size_t num_envs, std::uint64_t start,
+                    const std::vector<std::size_t>& counts) {
+  InspectableQueue vector_queue(num_envs, start);
+  InspectableQueue generated_queue(num_envs, start);
+  int first = 0;
+  std::uint64_t position = start;
+  for (const auto count : counts) {
+    SCOPED_TRACE(first);
+    std::vector<ActionSlice> expected;
+    for (std::size_t i = 0; i < count; ++i) {
+      expected.push_back(MakeAction(first + static_cast<int>(i)));
+    }
+    std::size_t calls = 0;
+    bool increasing_indices = true;
+    auto getter = [&](std::size_t i) noexcept {
+      increasing_indices = increasing_indices && i == calls;
+      ++calls;
+      return MakeAction(first + static_cast<int>(i));
+    };
+    vector_queue.EnqueueBulk(expected);
+    generated_queue.EnqueueBulkGenerated(count, getter);
+    EXPECT_EQ(calls, count);
+    EXPECT_TRUE(increasing_indices);
+    position += count;
+    EXPECT_EQ(vector_queue.Allocated(), position);
+    EXPECT_EQ(generated_queue.Allocated(), position);
+    EXPECT_EQ(vector_queue.SizeApprox(), count);
+    EXPECT_EQ(generated_queue.SizeApprox(), count);
+    for (std::size_t i = 0; i < count; ++i) {
+      ExpectSame(vector_queue.Dequeue(), expected[i]);
+      ExpectSame(generated_queue.Dequeue(), expected[i]);
+      EXPECT_EQ(vector_queue.SizeApprox(), count - i - 1);
+      EXPECT_EQ(generated_queue.SizeApprox(), count - i - 1);
+    }
+    EXPECT_EQ(vector_queue.Dequeued(), position);
+    EXPECT_EQ(generated_queue.Dequeued(), position);
+    first += static_cast<int>(count);
+  }
+}
+
