+TEST(GeneratedEnqueueTest, MixedApisPreserveFifoWithPendingActions) {
+  InspectableQueue queue(3);
+  std::deque<ActionSlice> expected;
+  int next = 0;
+  auto enqueue = [&](int count, bool generated) {
+    Enqueue(&queue, next, count, generated);
+    for (int i = 0; i < count; ++i) {
+      expected.push_back(MakeAction(next++));
+    }
+    EXPECT_EQ(queue.SizeApprox(), expected.size());
+  };
+  auto dequeue = [&](int count) {
+    for (int i = 0; i < count; ++i) {
+      ExpectSame(queue.Dequeue(), expected.front());
+      expected.pop_front();
+      EXPECT_EQ(queue.SizeApprox(), expected.size());
+    }
+  };
+  enqueue(4, false);
+  dequeue(3);
+  enqueue(4, true);  // Wrap with one vector-produced action still pending.
+  dequeue(2);
+  enqueue(3, true);  // Fill all six slots without overwriting pending work.
+  dequeue(6);
+  enqueue(2, true);
+  enqueue(3, false);
+  dequeue(5);
+  EXPECT_TRUE(expected.empty());
+  EXPECT_EQ(queue.Allocated(), next);
+  EXPECT_EQ(queue.Dequeued(), next);
+}
