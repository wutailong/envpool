+TEST(GeneratedEnqueueTest, MatchesVectorAtUnsignedCounterRollover) {
+  constexpr auto kStart = std::numeric_limits<std::uint64_t>::max() - 2;
+  // The first four tickets visit distinct slots even for the six-entry ring:
+  // 1, 2, 3, 0. Do not exceed that rollover window before draining it.
+  for (std::size_t num_envs : {3U, 4U}) {
+    SCOPED_TRACE(num_envs);
+    CompareBatches(num_envs, kStart, {4, 2 * num_envs, 1, 3, 2 * num_envs, 5});
+  }
+}
