+  queue.EnqueueBulkGenerated(3, getter);
+  EXPECT_EQ(rvalue_calls, 3);
+  EXPECT_EQ(lvalue_calls, 0);
+  for (int i = 0; i < 3; ++i) {
+    ExpectSame(queue.Dequeue(), MakeAction(i));
+  }
+  EXPECT_EQ(queue.SizeApprox(), 0);
+}
