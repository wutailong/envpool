+TEST(GeneratedEnqueueTest, BoundedMixedProducersConsumersDeliverExactlyOnce) {
+  constexpr int kProducers = 3;
+  constexpr int kConsumers = 3;
+  constexpr int kPerProducer = 192;
+  constexpr int kTotal = kProducers * kPerProducer;
+  for (int num_envs : {1, 3}) {
+    SCOPED_TRACE(num_envs);
+    InspectableQueue queue(num_envs);
+    const int capacity = 2 * num_envs;
+    QueueCredits credits(capacity);
+    std::promise<void> start;
+    auto ready = start.get_future().share();
+    std::array<std::vector<ActionSlice>, kConsumers> received;
+    std::vector<std::thread> consumers;
+    std::vector<std::thread> producers;
+    for (int consumer = 0; consumer < kConsumers; ++consumer) {
+      consumers.emplace_back([&, consumer] {
+        auto& actions = received[consumer];
+        actions.reserve(kTotal / kConsumers);
+        ready.wait();
+        for (int i = 0; i < kTotal / kConsumers; ++i) {
+          actions.push_back(queue.Dequeue());
+          credits.Release();
+        }
+      });
+    }
+    for (int producer = 0; producer < kProducers; ++producer) {
+      producers.emplace_back([&, producer] {
+        ready.wait();
+        for (int sent = 0; sent < kPerProducer;) {
+          const int count =
+              std::min(1 + (sent + producer) % std::min(capacity, 3),
+                       kPerProducer - sent);
+          credits.Acquire(count);
+          Enqueue(&queue, producer * kPerProducer + sent, count,
+                  (producer + sent) % 2 == 0);
+          sent += count;
+        }
+      });
+    }
+    start.set_value();
+    for (auto& producer : producers) {
+      producer.join();
+    }
+    for (auto& consumer : consumers) {
+      consumer.join();
+    }
+    std::vector<ActionSlice> all;
+    for (const auto& actions : received) {
+      all.insert(all.end(), actions.begin(), actions.end());
+    }
+    ASSERT_EQ(all.size(), kTotal);
+    std::sort(all.begin(), all.end(), [](const auto& lhs, const auto& rhs) {
+      return lhs.order < rhs.order;
+    });
+    for (int i = 0; i < kTotal; ++i) {
+      ExpectSame(all[i], MakeAction(i));
+    }
+    EXPECT_EQ(queue.SizeApprox(), 0);
+    EXPECT_EQ(queue.Allocated(), kTotal);
+    EXPECT_EQ(queue.Dequeued(), kTotal);
+  }
+}
+
+TEST(GeneratedEnqueueTest, ConcurrentMixedBulksPublishContiguousPayloads) {
+  constexpr int kRounds = 64;
+  constexpr int kStride = 4;
+  constexpr std::array<int, 3> kBatchSizes{1, 2, 3};
+  constexpr int kTotal = kRounds * 6;
+  InspectableQueue queue(5);
+  QueueCredits credits(10);
+  std::promise<void> start;
+  auto ready = start.get_future().share();
+  std::vector<ActionSlice> received;
+  std::thread consumer([&] {
+    received.reserve(kTotal);
+    ready.wait();
+    for (int i = 0; i < kTotal; ++i) {
+      received.push_back(queue.Dequeue());
+      credits.Release();
+    }
+  });
+  std::vector<std::thread> producers;
+  for (int producer = 0; producer < 3; ++producer) {
+    producers.emplace_back([&, producer] {
+      ready.wait();
+      for (int round = 0; round < kRounds; ++round) {
+        const int batch = producer * kRounds + round;
+        credits.Acquire(kBatchSizes[producer]);
+        Enqueue(&queue, batch * kStride, kBatchSizes[producer],
+                (producer + round) % 2 == 0);
+      }
+    });
+  }
+  start.set_value();
+  for (auto& producer : producers) {
+    producer.join();
+  }
+  consumer.join();
+  ASSERT_EQ(received.size(), kTotal);
+  std::array<int, 3 * kRounds> seen{};
+  for (int pos = 0; pos < kTotal;) {
+    const int order = received[pos].order;
+    ASSERT_GE(order, 0);
+    ASSERT_EQ(order % kStride, 0);
+    const int batch = order / kStride;
+    ASSERT_LT(batch, static_cast<int>(seen.size()));
+    const int count = kBatchSizes[batch / kRounds];
+    ASSERT_LE(pos + count, kTotal);
+    ++seen[batch];
+    for (int i = 0; i < count; ++i) {
+      ExpectSame(received[pos + i], MakeAction(order + i));
+    }
+    pos += count;
+  }
+  for (const int count : seen) {
+    EXPECT_EQ(count, 1);
+  }
+  EXPECT_EQ(queue.SizeApprox(), 0);
+  EXPECT_EQ(queue.Allocated(), kTotal);
+  EXPECT_EQ(queue.Dequeued(), kTotal);
+}
+
+TEST(GeneratedEnqueueTest, DelayedConsumerKeepsGeneratedPayloadAcrossReuse) {
+  constexpr int kTotal = 256;
+  InspectableQueue queue(1);
+  Enqueue(&queue, 0, 2, true);
+  std::promise<void> copied;
+  auto first_copied = copied.get_future();
+  std::promise<void> finish;
+  auto may_finish = finish.get_future();
+  ActionSlice delayed{};
+  std::thread consumer([&] {
+    delayed = queue.Dequeue();
+    copied.set_value();
+    may_finish.wait();
+  });
+  first_copied.wait();
+  // Hold the consumer after its copy, never inside the getter or dequeue.
+  // At most two actions remain outstanding, including that delayed action.
+  for (int i = 1; i < kTotal; ++i) {
+    if (i > 1) {
+      Enqueue(&queue, i, 1, i % 2 == 0);
+    }
+    ExpectSame(queue.Dequeue(), MakeAction(i));
+  }
+  finish.set_value();
+  consumer.join();
+  ExpectSame(delayed, MakeAction(0));
+  EXPECT_EQ(queue.SizeApprox(), 0);
+  EXPECT_EQ(queue.Allocated(), kTotal);
+  EXPECT_EQ(queue.Dequeued(), kTotal);
+}
+
+TEST(GeneratedEnqueueTest, StopAwareShutdownDoesNotReadGeneratedSlots) {
+  constexpr std::size_t kConsumers = 5;
+  for (bool leave_pending : {false, true}) {
+    SCOPED_TRACE(leave_pending);
+    InspectableQueue queue(1);
+    std::atomic<int> stop{0};
+    Enqueue(&queue, 0, 2, true);
+    if (!leave_pending) {
+      for (int i = 0; i < 2; ++i) {
+        ActionSlice output{};
+        ASSERT_TRUE(queue.DequeueOrStop(&output, stop));
+        ExpectSame(output, MakeAction(i));
+      }
+    }
+    const auto dequeued = queue.Dequeued();
+    const ActionSlice untouched{.env_id = -1, .order = -2, .force_reset = true};
+    std::array<ActionSlice, kConsumers> output;
+    output.fill(untouched);
+    std::array<bool, kConsumers> delivered{};
+    std::vector<std::thread> consumers;
+    // Producers are quiescent before stop and wake, even with real permits
+    // pending. More consumers than slots must not need dummy payload writes.
+    stop.store(1, std::memory_order_release);
+    for (std::size_t i = 0; i < kConsumers; ++i) {
+      consumers.emplace_back(
+          [&, i] { delivered[i] = queue.DequeueOrStop(&output[i], stop); });
+    }
+    queue.WakeForShutdown(kConsumers);
+    for (auto& consumer : consumers) {
+      consumer.join();
+    }
+    for (std::size_t i = 0; i < kConsumers; ++i) {
+      EXPECT_FALSE(delivered[i]);
+      ExpectSame(output[i], untouched);
+    }
+    EXPECT_EQ(queue.Allocated(), 2);
+    EXPECT_EQ(queue.Dequeued(), dequeued);
+    EXPECT_EQ(queue.SizeApprox(), leave_pending ? 2 : 0);
+    ExpectSame(queue.Slot(0), MakeAction(0));
+    ExpectSame(queue.Slot(1), MakeAction(1));
+  }
+}
