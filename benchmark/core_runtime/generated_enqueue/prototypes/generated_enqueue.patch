+constexpr int kPoolBatch = 3;
+constexpr std::array<int, kPoolBatch> kReorderedIds{2, 0, 1};
+
+struct ParseGate {
+  explicit ParseGate(bool enabled) : open(!enabled) { prepared.fill(-1); }
+
+  void BeforeParse(int env_id) {
+    std::unique_lock<std::mutex> lock(mutex);
+    if (!open && prepared[env_id] < 0) {
+      prepared[env_id] = set_actions.load();
+      ++entered;
+      condition.notify_all();
+    }
+    condition.wait(lock, [&] { return open; });
+  }
+
+  void WaitForWorkers() {
+    std::unique_lock<std::mutex> lock(mutex);
+    condition.wait(lock, [&] { return entered == kPoolBatch; });
+  }
+
+  void Open() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      open = true;
+    }
+    condition.notify_all();
+  }
+
+  std::atomic<int> set_actions{0};
+  std::array<int, kPoolBatch> prepared;
+  std::mutex mutex;
+  std::condition_variable condition;
+  int entered{0};
+  bool open;
+};
+
+class GeneratedPoolFns {
+ public:
+  static auto DefaultConfig() {
+    return MakeDict("gate"_.Bind(std::shared_ptr<ParseGate>()));
+  }
+
+  template <typename Config>
+  static auto StateSpec(const Config&) {
+    return MakeDict("obs"_.Bind(Spec<int>({})));
+  }
+
+  template <typename Config>
+  static auto ActionSpec(const Config&) {
+    return MakeDict("value"_.Bind(Spec<int>({})));
+  }
+};
+
+using GeneratedPoolSpec = EnvSpec<GeneratedPoolFns>;
+
+class GeneratedPoolEnv : public Env<GeneratedPoolSpec> {
+ public:
+  GeneratedPoolEnv(const Spec& spec, int env_id)
+      : Env<GeneratedPoolSpec>(spec, env_id), gate_(spec.config["gate"_]) {}
+
+  void SetAction(std::shared_ptr<std::vector<Array>> batch, int index) {
+    Env<GeneratedPoolSpec>::SetAction(std::move(batch), index);
+    ++gate_->set_actions;
+  }
+
+  bool IsDone() override {
+    // AsyncEnvPool calls IsDone before ParseAction. The second call, from
+    // Allocate, passes immediately after the test opens this gate.
+    gate_->BeforeParse(env_id_);
+    return false;
+  }
+
+  void Reset() override {
+    auto state = Allocate();
+    state["obs"_] = -1000 - env_id_;
+    state["reward"_].Fill(0.0F);
+  }
+
+  void Step(const Action& action) override {
+    auto state = Allocate();
+    state["obs"_] = static_cast<int>(action["value"_]);
+    state["reward"_].Fill(0.0F);
+  }
+
+ private:
+  std::shared_ptr<ParseGate> gate_;
+};
+
+using GeneratedPool = AsyncEnvPool<GeneratedPoolEnv>;
+
+GeneratedPoolSpec MakePoolSpec(const std::shared_ptr<ParseGate>& gate,
+                               bool synchronous) {
+  auto config = GeneratedPoolSpec::kDefaultConfig;
+  config["num_envs"_] = synchronous ? kPoolBatch : kPoolBatch + 1;
+  config["batch_size"_] = kPoolBatch;
+  config["num_threads"_] = kPoolBatch;
+  config["gate"_] = gate;
+  return GeneratedPoolSpec(config);
+}
+
+std::vector<Array> MakePoolActions() {
+  std::vector<Array> batch;
+  for (int field = 0; field < 3; ++field) {
+    batch.emplace_back(Spec<int>({kPoolBatch}));
+    for (int i = 0; i < kPoolBatch; ++i) {
+      batch.back()[i] = field < 2 ? kReorderedIds[i] : 100 + i * 17;
+    }
+  }
+  return batch;
+}
+
+void ExpectPoolOutput(const std::vector<Array>& output, bool synchronous,
+                      bool reset) {
+  GeneratedPoolEnv::State state(output);
+  ASSERT_EQ(state["info:env_id"_].size, kPoolBatch);
+  ASSERT_EQ(state["obs"_].size, kPoolBatch);
+  std::array<int, kPoolBatch> seen{};
+  for (int row = 0; row < kPoolBatch; ++row) {
+    const int env_id = state["info:env_id"_][row];
+    ASSERT_GE(env_id, 0);
+    ASSERT_LT(env_id, kPoolBatch);
+    ++seen[env_id];
+    if (synchronous) {
+      EXPECT_EQ(env_id, kReorderedIds[row]);
+    }
+    const auto found =
+        std::find(kReorderedIds.begin(), kReorderedIds.end(), env_id);
+    const int index = static_cast<int>(found - kReorderedIds.begin());
+    EXPECT_EQ(static_cast<int>(state["obs"_][row]),
+              reset ? -1000 - env_id : 100 + index * 17);
+  }
+  for (const int count : seen) {
+    EXPECT_EQ(count, 1);
+  }
+}
+
+}  // namespace
+
+TEST(GeneratedEnqueueTest, PoolSendOverloadsRetainActionsBeforePublication) {
+  for (bool synchronous : {false, true}) {
+    for (int overload = 0; overload < 3; ++overload) {
+      SCOPED_TRACE(synchronous);
+      SCOPED_TRACE(overload);
+      auto gate = std::make_shared<ParseGate>(true);
+      auto pool =
+          std::make_unique<GeneratedPool>(MakePoolSpec(gate, synchronous));
+      std::vector<std::weak_ptr<char>> storage;
+      {
+        auto batch = MakePoolActions();
+        for (const auto& array : batch) {
+          storage.emplace_back(array.SharedPtr());
+        }
+        if (overload == 0) {
+          pool->Send(static_cast<const std::vector<Array>&>(batch));
+        } else if (overload == 1) {
+          pool->Send(std::move(batch));
+        } else {
+          GeneratedPoolEnv::Action action(batch);
+          pool->Send(action);
+        }
+      }
+      // No caller-owned Array remains. Workers are held before ParseAction,
+      // and none accesses the destroyed/moved-from source vector.
+      gate->WaitForWorkers();
+      bool retained = true;
+      for (const auto& observer : storage) {
+        retained = retained && !observer.expired();
+      }
+      gate->Open();
+      auto output = pool->Recv();
+      pool.reset();  // Join all workers before inspecting their records.
+      EXPECT_TRUE(retained);
+      EXPECT_EQ(gate->set_actions.load(), kPoolBatch);
+      for (const int prepared : gate->prepared) {
+        EXPECT_EQ(prepared, kPoolBatch);
+      }
+      ExpectPoolOutput(output, synchronous, false);
+      for (const auto& observer : storage) {
+        EXPECT_TRUE(observer.expired());
+      }
+    }
+  }
+}
+
+TEST(GeneratedEnqueueTest, PoolResetPreservesTemporaryReorderedIds) {
+  for (bool synchronous : {false, true}) {
+    for (const std::vector<int>& shape :
+         {std::vector<int>{kPoolBatch}, {kPoolBatch, 2}, {kPoolBatch, 2, 2}}) {
+      SCOPED_TRACE(synchronous);
+      SCOPED_TRACE(shape.size());
+      auto gate = std::make_shared<ParseGate>(false);
+      auto pool =
+          std::make_unique<GeneratedPool>(MakePoolSpec(gate, synchronous));
+      {
+        Array ids{Spec<int>(shape)};
+        auto* values = static_cast<int*>(ids.Data());
+        const std::size_t stride = ids.size / kPoolBatch;
+        for (int row = 0; row < kPoolBatch; ++row) {
+          for (std::size_t col = 0; col < stride; ++col) {
+            // Rank two is [[2,1], [0,2], [1,0]]. Only each row's first
+            // element is an ID, matching TArray<int>::operator[] semantics.
+            values[row * stride + col] =
+                col == 0 ? kReorderedIds[row] : (row + col) % kPoolBatch;
+          }
+        }
+        pool->Reset(ids);
+      }
+      auto output = pool->Recv();
+      pool.reset();
+      ExpectPoolOutput(output, synchronous, true);
+      EXPECT_EQ(gate->set_actions.load(), 0);
+    }
+  }
+}
