+	// Altered isolated diagnostic copy: returns the existing positive release
+	// request count. This is not a count of actual kernel wake syscalls.
+	std::size_t DiagnosticSignalReleaseRequests(ssize_t count = 1)
+	{
+		assert(count >= 0);
+		ssize_t oldCount = m_count.fetch_add(count, std::memory_order_release);
+		ssize_t toRelease = -oldCount < count ? -oldCount : count;
+		if (toRelease > 0)
+		{
+			m_sema.signal(static_cast<int>(toRelease));
+		}
+		return toRelease > 0 ? static_cast<std::size_t>(toRelease) : 0;
+	}
 	
