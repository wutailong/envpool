+  struct DiagnosticEnqueueClockStamp {
+    std::uint64_t wall_ns = 0;
+    std::uint64_t caller_cpu_ns = 0;
+    bool valid = false;
+  };
+
+  static DiagnosticEnqueueClockStamp DiagnosticReadEnqueueClocks(
+      DiagnosticEnqueueProfile* profile) {
+    timespec wall{};
+    timespec cpu{};
+    const int wall_error = clock_gettime(CLOCK_MONOTONIC, &wall);
+    const int cpu_error = clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu);
+    profile->clock_errors += (wall_error != 0) + (cpu_error != 0);
+    if (wall_error != 0 || cpu_error != 0) {
+      return {};
+    }
+    constexpr std::uint64_t kNsPerSecond = 1000000000ULL;
+    return {static_cast<std::uint64_t>(wall.tv_sec) * kNsPerSecond +
+                static_cast<std::uint64_t>(wall.tv_nsec),
+            static_cast<std::uint64_t>(cpu.tv_sec) * kNsPerSecond +
+                static_cast<std::uint64_t>(cpu.tv_nsec),
+            true};
+  }
+
+  static void DiagnosticRecordEnqueueClocks(
+      const std::array<DiagnosticEnqueueClockStamp, 5>& stamps,
+      std::size_t action_count, std::size_t post_requests,
+      DiagnosticEnqueueProfile* profile) {
+    ++profile->completed_calls;
+    // Positive toRelease requests from the existing signal calculation. The
+    // POSIX backend can retry sem_post; actual calls/wake syscalls are unobserved.
+    profile->work_permit_posix_post_requests += post_requests;
+    for (const auto& stamp : stamps) {
+      if (!stamp.valid) {
+        return;
+      }
+    }
+    for (std::size_t i = 0; i < 4; ++i) {
+      if (stamps[i + 1].wall_ns < stamps[i].wall_ns ||
+          stamps[i + 1].caller_cpu_ns < stamps[i].caller_cpu_ns) {
+        ++profile->invalid_interval_calls;
+        return;
+      }
+    }
+    ++profile->timed_calls;
+    profile->timed_actions += action_count;
+    for (std::size_t i = 0; i < 4; ++i) {
+      profile->wall_ns[i] += stamps[i + 1].wall_ns - stamps[i].wall_ns;
+      profile->caller_cpu_ns[i] +=
+          stamps[i + 1].caller_cpu_ns - stamps[i].caller_cpu_ns;
+    }
+  }
